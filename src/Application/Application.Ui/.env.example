# Base url of the manager api (join requests and the manager hub).
# Default when unset: http://localhost:60510 (docker compose override)
VITE_MANAGER_URL=http://localhost:60510

# Camera gaze (MediaPipe Face Landmarker). Defaults are the official model and the jsDelivr wasm of the installed version.
# Set both to self hosted copies to avoid third party requests.
# VITE_FACE_LANDMARKER_MODEL_URL=/models/face_landmarker.task
# VITE_MEDIAPIPE_WASM_URL=/mediapipe/wasm
