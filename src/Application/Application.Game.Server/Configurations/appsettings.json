{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "CorsConfiguration": {
      "AllowAll": true
    },
    "EventbusConfiguration": {
      "ConnectionString": "amqp://rabbitmq:5672"
    },
    "ManagementApiConfiguration": {
      "BaseUrl": "https://Application.Manager.Api",
      "ApiKey": "E1F7F301-B9DD-4CE0-A4FF-85DC46B3624D"

    }
  },
  "ServerConfiguration": {
    "Domain": "localhost",
    "Scheme": "https",
    "Path": null,
    "Port": null,

    "RoomsConfiguration": {
      "MaxRooms": 2,
      "MaxPlayersPerRoom": 5,
      "MaxFoods": 50,
      "Width": 1920,
      "Height": 1080
    },
    "FoodConfiguration": {
      "FoodGenerationInterval": 50,
      "FoodSize": 15
    },
    "SnakeConfiguration": {
      "Speed": 15,
      "HeadSize": 15,
      "InitialSnakeSize": 5
    }
  },
  "PerkConfiguration": {
    "Enabled": true,
    "ShotSpreadDegrees": 12,
    "Perks": [
      { "Id": "swift", "Name": "Swift", "FoodsRequired": 8, "Effect": "BoostSpeed", "Amount": 0.25 },
      { "Id": "twin-shot", "Name": "Twin shot", "FoodsRequired": 15, "Effect": "ExtraShots", "Amount": 1 },
      { "Id": "quick-reload", "Name": "Quick reload", "FoodsRequired": 25, "Effect": "FasterReload", "Amount": 0.35 },
      { "Id": "deep-lungs", "Name": "Deep lungs", "FoodsRequired": 35, "Effect": "EfficientBoost", "Amount": 0.5 },
      { "Id": "triple-shot", "Name": "Triple shot", "FoodsRequired": 50, "Effect": "ExtraShots", "Amount": 1 },
      { "Id": "turbo", "Name": "Turbo", "FoodsRequired": 70, "Effect": "BoostSpeed", "Amount": 0.3 }
    ]
  },
  "PrizeConfiguration": {
    "Enabled": true,
    "SpawnIntervalSeconds": 60,
    "LifetimeSeconds": 45,
    "Value": 20,
    "FoodsCredit": 8,
    "MinPlayers": 2
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
