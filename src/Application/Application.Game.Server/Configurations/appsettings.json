{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AppSettings": {
    "CorsConfiguration": {
      "AllowAll": true
    },
    "EventbusConfiguration": {
      "ConnectionString": "amqp://rabbitmq:5672"
    },
    "ManagementApiConfiguration": {
      "BaseUrl": "https://Application.Manager.Api",
      "ApiKey": "E1F7F301-B9DD-4CE0-A4FF-85DC46B3624D"

    }
  },
  "ServerConfiguration": {
    "Domain": "localhost",
    "Scheme": "https",
    "Path": null,
    "Port": null,

    "RoomsConfiguration": {
      "MaxRooms": 2,
      "MaxPlayersPerRoom": 5,
      "MaxFoods": 50,
      "Width": 1920,
      "Height": 1080
    },
    "FoodConfiguration": {
      "FoodGenerationInterval": 50,
      "FoodSize": 15
    },
    "SnakeConfiguration": {
      "Speed": 15,
      "HeadSize": 15,
      "InitialSnakeSize": 5
    }
  },
  "PerkConfiguration": {
    "Enabled": true,
    "ShotSpreadDegrees": 12,
    "BurstIntervalMilliseconds": 80
  },
  "PrizeConfiguration": {
    "Enabled": true,
    "SpawnIntervalSeconds": 60,
    "LifetimeSeconds": 45,
    "Value": 20,
    "FoodsCredit": 8,
    "MinPlayers": 2
  },
  "WorldEventConfiguration": {
    "Enabled": true,
    "Lightning": {
      "Enabled": true,
      "MinIntervalSeconds": 45,
      "MaxIntervalSeconds": 120,
      "Radius": 90,
      "TelegraphMilliseconds": 1500,
      "MinStrikes": 5,
      "MaxStrikes": 12,
      "StormSeconds": 6,
      "AimedShare": 0.25
    },
    "Meteors": {
      "Enabled": true,
      "MinIntervalSeconds": 120,
      "MaxIntervalSeconds": 300,
      "Radius": 130,
      "TelegraphMilliseconds": 2000,
      "MinMeteors": 6,
      "MaxMeteors": 14,
      "RainSeconds": 8,
      "AimedShare": 0.2
    },
    "Turret": {
      "Enabled": true,
      "MinIntervalSeconds": 180,
      "MaxIntervalSeconds": 420,
      "LifetimeSeconds": 90,
      "HitPoints": 40,
      "Size": 60,
      "FireIntervalMilliseconds": 900,
      "Arms": 6,
      "SpinDegrees": 11,
      "ShotSpeed": 0.5,
      "MinPlayers": 2,
      "RewardMass": 60
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
