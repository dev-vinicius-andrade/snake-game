# Copy to .env (same folder) and fill in. deploy.sh reads it; a variable set in the shell wins over this file.
# Never put passwords here: the registry login is `podman login`, and the cluster Secrets are made by the script.

# Required: registry and project the images go to.
REGISTRY=cr.homel4b.dev/home-apps

# The kube context to deploy to (kubectl config get-contexts -o name).
KUBE_CONTEXT=default

# The one public host: / the site, /api the manager, /game the game server.
# A name two levels or deeper under the domain needs a Cloudflare Advanced Certificate (see README.md).
PUBLIC_HOST=snake.web.games.andradev.io

# Sign in with a social account (optional, per provider; a provider with no keys is not offered). Register the game with the provider and
# set its callback address to https://<PUBLIC_HOST>/api/accounts/oauth/<github|discord|google>/callback (see docs/ACCOUNTS.md).
# OAUTH_GITHUB_CLIENT_ID=
# OAUTH_GITHUB_CLIENT_SECRET=
# OAUTH_DISCORD_CLIENT_ID=
# OAUTH_DISCORD_CLIENT_SECRET=
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

# Optional.
# DOMAIN=andradev.io
# TUNNEL=true
# INGRESS=false
# TAG=
