{
  "uid": "snake-site-access",
  "title": "Snake game: site access",
  "tags": [
    "snake-game",
    "loki"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "description": "How many people reached the site, from the access log of the snake-ui pod (nginx, JSON lines) shipped to Loki.",
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Loki",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "textbox",
        "query": "home-apps",
        "current": {
          "text": "home-apps",
          "value": "home-apps"
        },
        "hide": 0
      },
      {
        "name": "pod",
        "label": "Pod (regex)",
        "type": "textbox",
        "query": "snake-ui-.*",
        "current": {
          "text": "snake-ui-.*",
          "value": "snake-ui-.*"
        },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "The site",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Page views",
      "description": "Pages sent to a browser (HTML answers) in the period. A visit that opens the site and then a join link counts twice.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Unique visitors",
      "description": "Different client addresses (the one Cloudflare passes on) that loaded a page in the period. Someone on two networks counts twice, two people behind one router count once.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "count(sum by (ip) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Games joined",
      "description": "Join requests the manager accepted (POST /api/join...) in the period.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | method=\"POST\" | path=~\"/api/join.*\" | status=~\"2..\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Requests",
      "description": "Every request the site answered, files and api calls included.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 18,
        "y": 1,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Page views over time",
      "description": "Pages sent to a browser.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" [$__interval]))",
          "legendFormat": "page views",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Unique visitors per hour",
      "description": "Different addresses that loaded a page in each hour.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "count(sum by (ip) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" [$__interval])))",
          "legendFormat": "visitors",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code",
          "interval": "1h"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "interval": "1h"
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Games joined over time",
      "description": "Accepted join requests.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | method=\"POST\" | path=~\"/api/join.*\" | status=~\"2..\" [$__interval]))",
          "legendFormat": "joins",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Requests by status",
      "description": "2xx fine, 4xx the visitor asked wrong, 5xx the site or the manager failed.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum by (status) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" [$__interval]))",
          "legendFormat": "{{status}}",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 101,
      "type": "row",
      "title": "Who",
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 9,
      "type": "bargauge",
      "title": "Visitors by country",
      "description": "Different addresses per country, from the CF-IPCountry header (XX or empty: unknown).",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "topk(10, count by (country) (sum by (country, ip) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" [$__range]))))",
          "legendFormat": "{{country}}",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Page views by page",
      "description": "The path of the page, without the query; a join link is /join/:code.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (path) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" [$__range])))",
          "legendFormat": "{{path}}",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Where visitors come from",
      "description": "The referer of the page request. Empty (typed address, an app that hides it) is left out.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 22,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "topk(10, sum by (ref) (count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" | ref!=\"\" [$__range])))",
          "legendFormat": "{{ref}}",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "showUnfilled": true
      }
    },
    {
      "id": 12,
      "type": "piechart",
      "title": "Phone or computer",
      "description": "Page views by the kind of browser, read from the user agent.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" | ua=~\".*(Mobile|Android|iPhone|iPad).*\" [$__range]))",
          "legendFormat": "Phone / tablet",
          "queryType": "instant",
          "refId": "A",
          "editorMode": "code"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" [$__range])) - sum(count_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\" | ua=~\".*(Mobile|Android|iPhone|iPad).*\" [$__range]))",
          "legendFormat": "Computer",
          "queryType": "instant",
          "refId": "B",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Data sent",
      "description": "Bytes the site answered with. The game itself goes over a websocket and is counted when the connection ends.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "sum(sum_over_time({namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | unwrap bytes [$__interval]))",
          "legendFormat": "bytes",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Slowest answers (95th percentile)",
      "description": "Seconds to answer, by path; websocket connections (/game) are left out because they stay open.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 30,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "quantile_over_time(0.95, {namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | path!~\"/game.*\" | unwrap rt [$__interval]) by (path)",
          "legendFormat": "{{path}}",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            },
            "lineWidth": 1
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 102,
      "type": "row",
      "title": "Requests",
      "gridPos": {
        "x": 0,
        "y": 38,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 15,
      "type": "logs",
      "title": "Latest page views",
      "description": "The latest pages sent, newest first.",
      "datasource": {
        "type": "loki",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 39,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "${datasource}"
          },
          "expr": "{namespace=\"$namespace\", pod=~\"$pod\"} | json | __error__=\"\" | ctype=~\"text/html.*\"",
          "legendFormat": "",
          "queryType": "range",
          "refId": "A",
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": false,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]
}
